<div class="registration-form-container d-flex align-items-center justify-content-center py-5 my-5">
  {%- assign formId = 'registration-form' -%}
  {% form 'create_customer', id: formId, class: formId, novalidate: 'novalidate' %}
    {% include 'form-status', form: form, form_id: 'registration-form' %}

    <div class="registration-form-header mb-5">
      {{ 'customer.register.title' | t }}
    </div>

    <div class="registration-form-input-group">
      <div class="registration-form-input-group-label required text-uppercase">
        NAME
      </div>
      <div class="registration-form-input-with-error-wrapper" id="registration-form-input-with-error-wrapper-firstname">
        <div class="registration-form-input-wrapper">
          <label for="{{ formId }}-firstname">{{ 'customer.register.first_name' | t }}</label>
          <input type="text" name="customer[first_name]" id="{{ formId }}-firstname" {% if form.first_name %}value="{{ form.first_name }}"{% endif %} autocomplete="given-name">
        </div>
        <div class="registration-form-error-message" id="registration-form-error-message-firstname"></div>
      </div>
      <div class="registration-form-input-with-error-wrapper" id="registration-form-input-with-error-wrapper-lastname">
        <div class="registration-form-input-wrapper">
          <label for="{{ formId }}-lastname">{{ 'customer.register.last_name' | t }}</label>
          <input type="text" name="customer[last_name]" id="{{ formId }}-lastname" {% if form.last_name %}value="{{ form.last_name }}"{% endif %} autocomplete="family-name">
        </div>
        <div class="registration-form-error-message" id="registration-form-error-message-lastname"></div>
      </div>
    </div>

    <div class="registration-form-input-group">
      <div class="registration-form-input-group-label required text-uppercase required">
        EMAIL & PASSWORD
      </div>
      <div class="registration-form-input-with-error-wrapper" id="registration-form-input-with-error-wrapper-email">
        <div class="registration-form-input-wrapper">
          <label for="{{ formId }}-email">{{ 'customer.register.email' | t }}</label>
          <input
            type="email"
            name="customer[email]"
            id="{{ formId }}-email"
            {% if form.email %} value="{{ form.email }}"{% endif %}
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            aria-required="true"
          >
        </div>
        <div class="registration-form-error-message" id="registration-form-error-message-email"></div>
      </div>
      <div class="registration-form-input-with-error-wrapper" id="registration-form-input-with-error-wrapper-password">
        <div class="registration-form-input-wrapper">
          <label for="{{ formId }}-password">{{ 'customer.register.password' | t }}</label>
          <input
            type="password"
            name="customer[password]"
            id="{{ formId }}-password"
            maxlength="15"
            class="{% if form.errors contains 'password' %} input--error{% endif %}"
            aria-required="true"
          >
          <div class="registration-form-input-wrapper-toggle-password text-capitalize" id="register-form-password-toggle">Show</div>
        </div>
        <div class="registration-form-input-wrapper-helper">(min. 6 max. 15 characters )</div>
        <div class="registration-form-error-message" id="registration-form-error-message-password"></div>
      </div>
    </div>

    <div class="registration-form-input-group policy-group">
      <div class="registration-form-policy-checkbox-wrapper">
        <input type="checkbox">
      </div>
      <div class="registration-form-policy-text">
        I accept the <a href="#">Terms and Conditions</a> and I have read and understood the <a href="#">Privacy Policy</a>
      </div>
    </div>

    {% comment %}
      {%- if form.errors contains 'email' -%}{% endif %}
      {%- if form.errors contains 'password' -%}{% endif %}
      {{ form.errors.translated_fields['password'] | capitalize }} {{ form.errors.messages['password'] }}
    {% endcomment %}

    <button type="submit">
      {{ 'customer.register.submit' | t }}
    </button>

  {% endform %}
</div>

{{ 'registration-form.js' | asset_url | script_tag }}