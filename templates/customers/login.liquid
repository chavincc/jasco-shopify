<div class="registration-form-container d-flex align-items-center justify-content-center py-5 my-5">
  <div id="CustomerLoginForm" class="form-vertical">
    {% form 'customer_login', novalidate: 'novalidate', class: 'registration-form' %}

      <div class="form-message form-message--success hide" id="ResetSuccess" tabindex="-1">
        {{ 'customer.recover_password.success' | t }}
      </div>
      {%- if form.errors -%}
        <div class="form-message form-message--error">
          <h2 class="h3 form-message__title " tabindex="-1" data-form-status>{{ 'contact.form.error_heading' | t }}</h2>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="registration-form-header mb-5" id="LoginHeading">
        {{ 'customer.login.title' | t }}
      </div>

      <div class="registration-form-input-group">
        <div
          class="registration-form-input-with-error-wrapper"
          id="registration-form-input-with-error-wrapper-email"
        >
          <div class="registration-form-input-wrapper">
            <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              {%- if form.errors contains 'form' -%}
                aria-invalid="true"
              {%- endif -%}
            >
          </div>
          <div class="registration-form-error-message" id="registration-form-error-message-email"></div>
        </div>
        <div
          class="registration-form-input-with-error-wrapper"
          id="registration-form-input-with-error-wrapper-password"
        >
          <div class="registration-form-input-wrapper">
            <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
            <input
              type="password"
              value=""
              name="customer[password]"
              id="CustomerPassword"
              {%- if form.errors contains 'form' -%}
                aria-invalid="true"
              {%- endif -%}
            >
            <div class="registration-form-input-wrapper-toggle-password text-capitalize" id="register-form-password-toggle">Show</div>
          </div>
          <div class="registration-form-error-message" id="registration-form-error-message-password"></div>
        </div>
      </div>

      <div class="login-button-group">
        <button type="submit">
          {{ 'customer.login.sign_in' | t }}
        </button>
        <a href="/account/register" class="registration-form-link-btn text-uppercase d-flex align-items-center justify-content-center">
          REGISTER
        </a>
        <a href="#recover" id="RecoverPassword">
          {{ 'customer.login.forgot_password' | t }}
        </a>
      </div>
    {% endform %}
  </div>

  <div id="RecoverPasswordForm" class="hide">

    <div class="registration-form-header mb-3">
      {{ 'customer.recover_password.title' | t }}
    </div>
    <div class="registration-form-subheader mb-5">
      {{ 'customer.recover_password.subtext' | t }}
    </div>

      {% form 'recover_customer_password', class: 'registration-form' %}

        {% if form.posted_successfully? %}
          <span class="hide reset-password-success"></span>
        {% endif %}

        <div class="registration-form-input-group">
          <div
            class="registration-form-input-with-error-wrapper{% if form.errors %} error{% endif %}"
            id="registration-form-input-with-error-wrapper-email"
          >
            <div class="registration-form-input-wrapper">
              <label for="RecoverEmail">{{ 'customer.recover_password.email' | t }}</label>
              <input
                type="email"
                value=""
                name="email"
                id="RecoverEmail"
                class="input-full"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="RecoverEmail-email-error"
                {%- endif -%}
                >
            </div>
            <div class="registration-form-error-message">{{ form.errors.messages['form'] }}</div>
          </div>
        </div>

        <div class="login-button-group">
          <button type="submit">{{ 'customer.recover_password.submit' | t }}</button>
          <a href="#LoginHeading" id="HideRecoverPasswordLink">{{ 'customer.recover_password.cancel' | t }}</a>
        </div>
      {% endform %}
    </div>

  {% if shop.checkout.guest_login %}
    <div class="text-center">
      <hr class="hr--invisible">
      <h2>{{ 'customer.login.guest_title' | t }}</h2>

      {% form 'guest_login' %}
        <input type="submit" class="btn" value="{{ 'customer.login.guest_continue' | t }}">
      {% endform %}
    </div>
  {% endif %}
</div>     