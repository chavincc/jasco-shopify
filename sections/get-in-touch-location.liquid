<section class="location pt-5 pb-5">
  <div class="row">
    <div class="location-header" class="text-uppercase">
      {{ section.settings.section_header }}
    </div>
  </div>
  <div class="row">
    <div class="location-tabs current text-capitalize" id="tab-bangkok">
      {{ section.settings.primary_location_name }}
    </div>
    <div class="divider-wrapper">
      <div class="divider"></div>
    </div>
    <div class="location-tabs text-capitalize" id="tab-chiangmai">
      Chiangmai
    </div>
  </div>
  <div class="row-divider"></div>
  <div class="row pt-4 pb-0 pb-md-5">
    <div class="col-md-6 col-12 pb-4 pb-md-0">
      <div class="location-address" id="location-address-ontab">
        {{ section.settings.primary_location_address }}
      </div>
    </div>
    <div class="col-md-6 col-12">
      <div class="row">
        <div class="col-lg-6 col-12 mb-3">
          <div class="row location-contact-info-wrap">
            <div class="location-contact-info-icon col-2">
              <img src={{ "get-in-touch-img-icon-tel.svg" | asset_url }}/>
            </div>
            <div class="col-9">{{ section.settings.primary_location_telephone }}</div>
          </div>
        </div>
        <div class="col-lg-6 col-12 mb-3">
          <div class="row location-contact-info-wrap">
            <div class="location-contact-info-icon col-2">
              <img src={{
                "get-in-touch-img-icon-paper-plane.svg" | asset_url
              }}/>
            </div>
            <div class="col-9">{{ section.settings.primary_location_email }}</div>
          </div>
        </div>
        <div class="col-lg-6 col-12 mb-3">
          <div class="row location-contact-info-wrap">
            <div class="location-contact-info-icon col-2">
              <img src={{ "get-in-touch-img-icon-fax.svg" | asset_url }}/>
            </div>
            <div class="col-9">{{ section.settings.primary_location_fax }}</div>
          </div>
        </div>
        <div class="col-lg-6 col-12 mb-3">
          <div class="row location-contact-info-wrap">
            <div class="location-contact-info-icon col-2">
              <img src={{ "get-in-touch-img-icon-line.svg" | asset_url }}/>
            </div>
            <div class="col-9">{{ section.settings.primary_location_line }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row pb-5">
    <div class="col-md-6 col-12 mt-3 pb-4 pb-md-0">
      <a target="_blank" href={{ section.settings.primary_location_link }} class="location-get-direction-button">
        <div class="location-get-direction-button-text text-uppercase">
          {{ section.settings.button_text }}
        </div>
        <div class="location-get-direction-button-icon">
          <img src={{ "get-in-touch-img-icon-location.svg" | asset_url }}/>
        </div>
      </a>
    </div>
    <div class="location-opening-hours col-md-6 col-12">
      <div class="location-opening-hours-header text-capitalize">
        {{ section.settings.primary_location_note_header }}
      </div>
      <div class="location-opening-hours-content">
        {{ section.settings.primary_location_note_body }}
      </div>
    </div>
  </div>
  <div class="row-divider"></div>
</section>

{% schema %}
  {
    "name": "location",
    "settings": [
      {
        "type": "text",
        "id": "section_header",
        "label": "section header"
      },
      {
        "type": "text",
        "id": "primary_location_name",
        "label": "primary location name"
      },
      {
        "type": "richtext",
        "id": "primary_location_address",
        "label": "primary location address"
      },
      {
        "type": "text",
        "id": "primary_location_telephone",
        "label": "primary location telephone"
      },
      {
        "type": "text",
