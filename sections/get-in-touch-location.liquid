        "label": "primary location email"
      },
      {
        "type": "text",
        "id": "primary_location_fax",
        "label": "primary location fax"
      },
      {
        "type": "text",
        "id": "primary_location_line",
        "label": "primary location line"
      },
      {
        "type": "text",
        "id": "primary_location_link",
        "label": "primary location map link"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "button text"
      },
      {
        "type": "text",
        "id": "primary_location_note_header",
        "label": "primary location note header"
      },
      {
        "type": "richtext",
