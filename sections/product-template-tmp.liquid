<section
    class="product-detail py-lg-5 pb-0 mt-5"
    id="product-detail"
    data-section-type="product"
    data-enable-history-state="true"
    data-ajax-enabled="{{ settings.enable_ajax }}"
>

  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign compare_at_price = current_variant.compare_at_price -%}
  {%- assign price = current_variant.price -%}

  <div class="row" id="product-detail-main">
    <div class="responsive-img-wrapper col-md-6 col-12 d-flex justify-content-center">
      <img class="responsive-img" src={{ current_variant | img_url: 'master' }} />
    </div>
    <div class="col-md-6 col-12" id="product-detail-brief">
      <div class="row mb-5 with-divider">
        <div class="col-12" id="product-detail-brief-collection">{{ product.metafields.global["main collection"] }}</div>
        <div class="col-12" id="product-detail-brief-name">{{ product.title }}</div>
        <div class="col-12" id="product-detail-brief-price">{{ current_variant.price | money_without_trailing_zeros }}</div>
        <div class="col-12" id="product-detail-brief-description">
          {{ product.description }}
        </div>
      </div>
      <div class="row mb-3 with-divider">
        <div class="col-12 d-flex">
          <div class="product-detail-tabs current text-capitalize" id="tab-description">
            Description
          </div>
          <div class="divider-wrapper">
            <div class="divider"></div>
          </div>
          <div class="product-detail-tabs text-capitalize" id="tab-dimension">
            Dimensions
          </div>
        </div>
      </div>
      <div class="row mb-4 with-divider">
        <div class="product-detail-description row">
          <div class="col-md-6 col-12 product-detail-description-item">lorem ipsum</div>
          <div class="col-md-6 col-12 product-detail-description-item">lorem ipsum</div>
          <div class="col-md-6 col-12 product-detail-description-item">lorem ipsum</div>
          <div class="col-md-6 col-12 product-detail-description-item">lorem ipsum</div>
          <div class="col-md-6 col-12 product-detail-description-item">lorem ipsum</div>
        </div>
      </div>
      {% form 'product', product, novalidate: 'novalidate', data-product-form: '' %}
        <div class="row d-flex flex-column mb-4">
            <div class="product-detail-order-header text-capitalize">
            Quantity
            </div>
            <div class="quantity-input-group d-flex align-items-center">
            -
            <div class="quantity-display d-flex align-items-center justify-content-center">
                0
            </div>
            +
            </div>
        </div>
        <div class="row d-flex flex-column mb-4">
            <div class="product-detail-order-header text-capitalize">
            Colors
            </div>
            <div class="product-detail-color-picker-wrapper d-flex">
            <div class="product-detail-color-picker current">
                <div class="product-detail-color-picker-inner-red"></div>
            </div>
            <div class="product-detail-color-picker">
                <div class="product-detail-color-picker-inner-green"></div>
            </div>
            </div>
        </div>
        <div class="row d-flex flex-column mb-5">
            <div class="product-detail-order-header text-capitalize">
            Size
            </div>
            <div class="product-detail-size-wrapper d-flex">
                <div class="product-detail-size">
                    750 ml.
                </div>
                <div class="divider-wrapper">
                    <div class="divider"></div>
                </div>
                <div class="product-detail-size">
                    600 ml.
                </div>
                <div class="divider-wrapper">
                    <div class="divider"></div>
                </div>
                <div class="product-detail-size current">
                    500 ml.
                </div>
                <div class="divider-wrapper">
                    <div class="divider"></div>
                </div>
                <div class="product-detail-size">
                    300 ml.
                </div>
            </div>
        </div>
        <div class="row mb-xl-3 mb-sm-5 mb-4">
            <div class="product-detail-button-group mb-sm-0 mb-3">
            <div class="add-to-cart text-uppercase d-flex align-items-center justify-content-center">
                ADD TO CART
            </div>
            <div class="wishlist-button text-uppercase d-flex align-items-center justify-content-center">
                <img src={{ 'product-img-icon-heart.svg' | asset_url }} />
            </div>
            </div>
        </div>
      {% endform %}
      <div class="row mb-3 d-flex flex-column">
        <div class="row d-flex align-items-center mb-xl-0 mb-3">
          <div class="col-xl-1 col-2"><img src={{ "landing-img-truck.svg" | asset_url }} /></div>
          <div class="col-xl-11 col-10 pl-5 product-detail-delivery-option-text text-uppercase">
            DELIVERY
          </div>
        </div>
        <div class="row d-flex align-items-center">
          <div class="col-xl-1 col-2"><img src={{ "landing-img-box.svg" | asset_url }} /></div>
          <div class="col-xl-11 col-10 pl-5 product-detail-delivery-option-text text-uppercase">
            RETURNS-CLAIMS
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="horizontal-divider-wrapper row my-5">
    <div class="horizontal-divider"></div>
  </div>
</section>

{% unless product == empty %}
  <script type="application/json" id="ProductJson-{{ section.id }}">
    {{ product | json }}
  </script>
  <script type="application/json" id="ModelJson-{{ section.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
{% endunless %}