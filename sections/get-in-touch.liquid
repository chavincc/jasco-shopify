<section class="get-in-touch pb-lg-5 pb-3" id="get-in-touch">
  <div
    class="responsive-img-wrapper row d-flex justify-content-end d-lg-none pb-5 px-0"
  >
    <div class="col-12 px-0 row d-flex justify-content-end m-0">
      <img class="responsive-img" src={{ "get-in-touch-img.png" | asset_url }}/>
    </div>
  </div>
  <div class="row pb-5">
    <div class="col-lg-6 col-12">
      <div class="row">
        <div class="get-in-touch-header text-uppercase py-lg-5 pb-3">
          GET IN TOUCH
        </div>
      </div>
      <div class="row pb-4">
        <div class="col-12 get-in-touch-subheader-wrapper">
          <div class="get-in-touch-subheader">
            Leave us your inquiries and we will contact you or call&nbsp;
            <span>02-721-2332</span>
          </div>
        </div>
      </div>
      <div class="row pb-4 pl-0">
        <div class="col-xl-6 col-12 pl-0 mb-xl-0 mb-4">
          <input placeholder="Name" type="text" />
        </div>
        <div class="col-xl-6 col-12 pl-0 pl-xl-3">
          <input placeholder="Email" type="text" />
        </div>
      </div>
      <div class="row pb-5 pl-0">
        <div class="col-12 pl-0">
          <input placeholder="Message *" type="text" />
        </div>
      </div>
      <div class="row d-flex justify-content-end">
        <div class="col-sm-6 col-9 pl-0 d-flex justify-content-end">
          <button class="text-uppercase">SEND</button>
        </div>
      </div>
    </div>
    <div class="col-1 d-lg-block d-none"></div>
    <div class="col-5 get-in-touch-img-wrapper d-lg-block d-none">
      <img class="get-in-touch-img" src={{ "get-in-touch-img.png" | asset_url }}
      />
    </div>
  </div>
</section>