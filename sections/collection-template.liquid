{%- assign max_height = 250 -%}

{% if section.settings.layout == 'grid' %}
  {%- assign limit = cart.attributes.pagination -%}
  {% else %}
  {%- assign limit = cart.attributes.pagination -%}
{% endif %}

{% paginate collection.products by limit %} 

<script>
  var PRODUCT_COLOR_MAP = {}
</script>  

<div data-section-id="{{ section.id }}" data-section-type="collection-template">
  <header class="collection-header">
    {%- assign is_filter_by_available = false -%}
    {%- if section.settings.tags_enable and collection.all_tags.size > 0 -%}
      {%- assign is_filter_by_available = true -%}
    {%- endif -%}
    <div class="page-width">
      <div class="section-header text-center">
        <h1>
            <span class="visually-hidden">{{ 'collections.general.collection_label' | t }}: </span>
            {{ collection.title }}
        </h1>
        {% if collection.description != blank %}
          <div class="rte">
            {{ collection.description }}
          </div>
        {% endif %}
        {% if is_filter_by_available == false and section.settings.sort_enable == false %}
          <span class="filters-toolbar__product-count">{{ 'collections.general.items_with_count' | t: count: collection.products_count }}</span>
        {% endif %}
      </div>
    </div>
    <div class= "row m-sm-5 m-1 pl-lg-0 pl-md-5 pl-0 pt-4" id="subpage-product-wrapper" style="margin:0px;">
      <div class="col-lg-3 col-6 d-lg-block d-md-none d-sm-block d-none" >
        {% comment %} area for displaying filter-side-bar {% endcomment %}
      </div>  
      <div class="col-lg-9 col-md-12 col-sm-6 col-12">
        {% if is_filter_by_available or section.settings.sort_enable %}
          <div class="rm-border-bottom filters-toolbar-wrapper{% if is_filter_by_available %} filters-toolbar--has-filter{% endif %}">
            <div class="page-width" style="padding-left:0px; padding-right:0px;">
              <div class="row filters-toolbar" id ="mock-meta">
                <div class="d-flex justify-content-start col-xl-7 col-12 mb-xl-0 mb-5" id="mock-meta-1">
                  {% include 'collection-tab-component' %}
                </div>
                <div class="col-xl-5 col-12 d-flex align-items-center justify-content-xl-center justify-content-md-start justify-content-center" id="mock-meta-2">
                  <div class="d-flex justify-content-start align-items-center filters-toolbar__item-wrapper">
                    {% include 'collection-sort-dropdown' %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </header>

  <section class="subpage-product-showcase row mt-5 ml-1 mock-row" id="subpage-product-showcase">
    {% for product in collection.products %}
      {% include 'collection-page-product', product: product %}
    {% else %}
      {% assign is_empty_collection = true %}
    {% endfor %}

    {% if is_empty_collection %}
      <div class="grid__item small--text-center">
        <p class="text-center">{{ 'collections.general.no_matches' | t }}</p>
      </div>
    {% endif %}
  </section>
  {%- if paginate.pages > 1 -%}
    {% include 'pagination', paginate: paginate %}
  {%- endif -%}
</div>

{% endpaginate %}

{% schema %}
{
  "name": {
    "en": "Collection pages",
    "th": "หน้าคอลเลกชัน"
  },
  "settings": [
    {
      "type": "range",
      "id": "grid",
      "label": {
        "en": "Products per row (grid only)",
        "th": "สินค้าต่อแถว (กริดเท่านั้น)"
      },
      "default": 4,
      "min": 2,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "rows",
      "label": {
        "en": "Rows per page (grid only)",
        "th": "แถวต่อหน้า (กริดเท่านั้น)"
      },
      "default": 2,
      "min": 2,
      "max": 8,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "sort_enable",
      "label": {
        "en": "Enable sorting",
        "th": "เปิดใช้งานการจัดเรียง"
      },
      "default": true
    },
    {
      "type": "checkbox",
      "id": "tags_enable",
      "label": {
        "en": "Enable tag filtering",
        "th": "เปิดใช้การกรองแท็ก"
      },
      "default": true
    }
  ]
}
{% endschema %}

{% javascript %}
const backToFirstPage = (queryStringVars = {page: "1"}) => {
  let existingQueryVars = location.search
    ? location.search.substring(1).split("&")
    : [];
  let currentUrl = location.search
    ? location.href.replace(location.search, "")
    : location.href;
  let newQueryVars = { };
  let newUrl = currentUrl + "?";
  if (existingQueryVars.length > 0) {
    for (let i = 0; i < existingQueryVars.length; i++) {
      let pair = existingQueryVars[i].split("=");
      newQueryVars[pair[0]] = pair[1];
    }
  }
  if (queryStringVars) {
    for (let queryStringVar in queryStringVars) {
      newQueryVars[queryStringVar] = queryStringVars[queryStringVar];
    }
  }
  if (newQueryVars) {
    for (let newQueryVar in newQueryVars) {
      newUrl += newQueryVar + "=" + newQueryVars[newQueryVar] + "&";
    }
    newUrl = newUrl.substring(0, newUrl.length - 1);
    window.location.href = newUrl;
  } else {
    window.location.href = location.href;
  }
};

$('#paginateBy').on('change', async function(){
  var val = $(this).val();
  await $.ajax({
  type: "POST",
  url: '/cart.js',
  data: {"attributes[pagination]": val}, 
  success: function(d){
    window.location.reload();
  },
  dataType: 'json'
  });
  backToFirstPage();
});
{% endjavascript %}

<script> 
  var url_current_path = {{canonical_url | json}};
</script>
<script src="{{ 'tab-component.js' | asset_url }}" > </script>
