<div class="shipping-bar-detail px-3">
  <div class="row px-5" id="row-shipping-bar" >
      <div class="col-md-3 col-sm-6 col-12 d-flex justify-content-center border-right border-secondary">
        <div class="text-uppercase d-flex align-items-center">
         <img src= "{{ section.settings.icon_delivery | img_url: 'medium' }}" >
          <p>{{section.settings.text_delivery}}</p>
        </div>
      </div>
      <div class="col-md-3 col-sm-6 col-12 d-flex justify-content-center border-right border-secondary">
        <div class="text-uppercase d-flex align-items-center">
          <img src= "{{ section.settings.icon_returns | img_url: 'medium' }}" >
          <p >{{section.settings.text_returns}}</p>
        </div>
      </div>
      <div class="col-md-3 col-sm-6 col-12 d-flex justify-content-center border-right border-secondary">
        <div class="text-uppercase d-flex align-items-center">
          <img src= "{{ section.settings.icon_faq | img_url: 'medium' }}" >
          <p>{{section.settings.text_faq}}</p>
        </div>
      </div>
      <div class="col-md-3 col-sm-6 col-12 d-flex justify-content-center">
        <div class="text-uppercase d-flex align-items-center">
          <img src= "{{ section.settings.icon_online | img_url: 'medium' }}" >
          <p >{{section.settings.text_online}}</p>
        </div>
      </div>
  </div>
</div>

{% schema %}
  {
    "name":"Shipping Detail",
    "settings":[
      {
        "type": "image_picker", 
        "id": "icon_delivery", 
        "label" : "Delivery icon"
      },
      {
      "type": "text", 
      "id": "text_delivery", 
      "label": "delivery text"
    },
    {
        "type": "image_picker", 
        "id": "icon_returns", 
        "label" : "Returns and Claims icon"
      },
    {
      "type": "text", 
      "id": "text_returns", 
      "label": "returns text"
    }, 
    {
        "type": "image_picker", 
        "id": "icon_faq", 
        "label" : "Faq icon"
    },
    {
      "type": "text", 
      "id": "text_faq", 
      "label": "faq text"
    },
     {
        "type": "image_picker", 
        "id": "icon_online", 
        "label" : "Online icon"
      },
    {
      "type": "text", 
      "id": "text_online", 
      "label": "online text"
    }
    ]
  }
{% endschema %}