{{ "product_section.css" | asset_url | stylesheet_tag }}


{% schema %}
{
    "name":"product-section", 
    "settings": [
        {
            "type": "text",
            "id": "section_title",
            "label": "Section title"  
        }
    ],
    
    "max_blocks":2,
    "blocks":[
        {
         "type": "image",
         "name": "Product", 
         "settings": [
            
            {
                 "type": "text",
                 "id": "heading-text",
                 "label": "Product heading"
            },
            {
                 "type": "text",
                 "id": "heading-caption",
                 "label": "Product caption"
            },
            {
                 "type": "text",
                 "id": "product-button",
                 "label": "Text in button"
            }
         ]
        }
    ]
}
{% endschema %}