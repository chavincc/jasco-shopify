<div class="row" style="margin:0px;">
    <div class="col-md-12 col-sm-12 col-xs-12 d-flex justify-content-center">
        <p id="header-shop">
            Shop by
        </p>
    </div>
</div>
<div class="row " id="logo" style="margin:0px; padding-bottom: 50px; ">
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-1 d-flex justify-content-center align-items-center">
