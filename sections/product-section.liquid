<div class="row" id= "row-product-title" >
    <div class="col-md-12 col-sm-12 col-xs-12 d-flex justify-content-center">
        <p id="header-product">{{section.settings.section_title}}</p>
    </div>
</div>
<div class="d-none d-md-block">
    <div class="row" style="margin:0px;">
        <div class="col-md-6" style="padding:0px;">
            <div class="img-front">
                <img src={{"product-section-img-productFront.png" | asset_url }}>
                <div class="images-caption">
                    <img src={{"product-section-img-bell.svg" | asset_url }} style="width: auto;">
                    <p>
                        FRONT OF HOUSE
                    </p>
                </div>
                <div class="overlay">
                    <div class="text-in-bar">
                        <p>
                            Lorem Ipsum is simply dummy text of the printing and typesetting industry.
                        </p>
                        <button class="view-product">
                            VIEW ALL PRODUCTS
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6" style="padding:0px;">
            <div class="img-back">
                <img src={{"product-section-img-productBack.png" | asset_url }}>
                <div class="images-caption">
                    <img src={{"product-section-img-kitchen.svg" | asset_url }} style="width: auto;">
                    <p>BACK OF HOUSE
                    </p>
                </div>
                <div class="overlay">
                    <div class="text-in-bar">
                        <p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>
                        <button class="view-product">
                            VIEW ALL PRODUCTS
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

