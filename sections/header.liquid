
<header>
  <div class="d-none d-lg-block" id="navbar-header">
    <div class="header-first-row" id="navbar-header-hide" role="navigation">
      <div class="row">
        <div class="col-lg-4 first-left d-flex justify-content-start">
          <div class="head-logo">
            {% include 'jasco-slogan' %}
          </div>
        </div>
        <div class="col-lg-8 col-md-block first-right d-flex justify-content-end align-items-center">
          <div class="head-actions">
            <ul class="list-inline d-flex justify-content-end align-items-center">
              {% assign top_menus = "STORE,CART,WISHLIST,LOGIN" | split: ','%}
              {% for head_menu in top_menus %}
                {% assign iconTitle = head_menu | prepend: "navbar-img-" | append: ".svg" %} 
                <li>   
                  <img id= "icon" src= {{ iconTitle | asset_url }}/> 
                  {% if head_menu == 'LOGIN' %}
                    {% if shop.customer_accounts_enabled %}
                      {% if customer %}
                        <a href="{{ routes.account_url }}">{{ head_menu }} </a>
                      {% else %}
                        <a href="{{ routes.account_login_url }}">{{ head_menu }}</a>
                      {% endif %}
                    {% endif %}
                  {% elsif head_menu == 'CART'%}
                    <a href="{{routes.cart_url }}" >{{ head_menu }}</a>
                    {% if cart.item_count != 0 %}
                      <div class="circle"><p>{{ cart.item_count }}</p></div>
                    {% endif %} 
                  {% else %}
                    <a href="/">{{ head_menu }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="header-second-row " id="navbar-header-hide">
      <div class="row align-items-center">
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-3"></div>
        <div class="col-xl-8 col-lg-8 col-md-4 col-sm-3 head-catalogue d-flex justify-content-end align-items-center">
          <button class="catalogueBtn">
          {% assign default_link = "https://cdn.shopify.com/s/files/1/0420/9711/5292/files/test_file_pdf.pdf?v=1593749203" %}
          {%if section.settings.button_catalogue_text == "" %} 
            {% if section.settings.catalogue_link == none %}
            <a href= "{{default_link}}" target="_blank">JASCO CATALOGUE </a>
            {% else %}
            <a href= "{{section.settings.catalogue_link}}" target="_blank" >JASCO CATALOGUE</a>
            {% endif %}
          {%else%}
            {% if section.settings.catalogue_link.url == none %}
            <a href= "{{default_link}}" target="_blank" >{{section.settings.button_catalogue_text}} </a>
            {% else %}
            <a href= "{{section.settings.catalogue_link}}" target="_blank" >{{section.settings.button_catalogue_text}}</a>
            {% endif %}
          {%endif%} 
         
          <img src={{'navbar-img-download.png' | asset_url }}>
          </button>
          <div class="head-search d-flex justify-content-end">
              <form action="/search-result" method="get">
                <input name="query" placeholder=" Search keyword..." type="text"/>
                  <button><img src={{'navbar-img-search.svg' | asset_url}}></button>
              </form>
          </div>
        </div>
      </div>
    </div>
    <div class="header-third-row collection-menu-row  d-flex justify-content-center align-items-center">
      <div class="container">
        <div class="collection-menu text-uppercase">
                <nav>
                    <ul class="list-inline d-flex justify-content-end align-items-center" id="page-header" >
                      {% assign number_menu = 0 %}
                      {% for link in linklists[section.settings.main_linklist].links %}
                         {% assign number_menu = number_menu | plus: 1 %} 
                      {%endfor%}
                      {% assign width_str = 100 | divided_by: number_menu  | append: '%' %}
                      {% for link in linklists[section.settings.main_linklist].links %}
                        <li style= "width:{{width_str}}">
                          <a href="{{ link.url }}">{{ link.title }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                </nav>
            </div>
        </div>
      </div> 
    {% include 'product-hover' %}
  </div>

  <div class="xs-head-row d-lg-none">
    <div class="xs-navbar" id="xs-navbar-filler">
        <div class="xs-head-logo">
          {% include 'jasco-slogan' %}
        </div>
    </div>
    <div class="sticky xs-navbar">
        <div class="xs-head-logo">
           {% include 'jasco-slogan' %}
        </div>
    </div>
    <button class="xs-head-bars" id="xs-head-bars" onclick="showHamburgerMenu()">
        <img id="menu" src={{'navbar-img-hamburger-menu.png' | asset_url }}/>
    </button>
    <div id="overlay-rec" onclick="hideMenuToggle()"></div>
    <div  class="xs-menu-toggle" id="xs-menu-toggle">
      <div class="xs-icon-links text-uppercase">
        <div class="d-flex justify-content-start" id="menu-title">
          <h5>Menu</h5>
        </div>
        <div id="line-square"></div>
            <div class="head-actions">
            <ul class="list-inline d-flex justify-content-start">
              {% assign top_menus = "STORE,CART,WISHLIST,LOGIN" | split: ','%}
              {% for head_menu in top_menus %}
                {% assign iconTitle = head_menu | prepend: "navbar-img-" | append: ".svg" %} 
                <li>   
                  <img id= "xs-icon" src= {{ iconTitle | asset_url }}/> 
                  {% if head_menu == 'LOGIN' %}
                    {% if shop.customer_accounts_enabled %}
                      {% if customer %}
                        <a href="{{ routes.account_url }}">{{ head_menu }} </a>
                      {% else %}
                        <a href="{{ routes.account_login_url }}">{{ head_menu }}</a>
                      {% endif %}
                    {% endif %}
                  {% elsif head_menu == 'CART'%}
                    <a href="{{routes.cart_url }}" >{{ head_menu }}</a>
                    {% if cart.item_count != 0 %}
                      <div class="circle"><p>{{ cart.item_count }}</p></div>
                    {% endif %} 
                  {% else %}
                    <a href="/">{{ head_menu }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
            </div>
            <div class="xs-head-search">
                <form action="/search-result" method="get">
                    <input name="query" placeholder="Search keyword... " type="text">
                    <button>
                        <img src={{"navbar-img-search.svg" | asset_url }}>
                    </button>
                </form>
            </div>
            <div class="d-flex justify-content-start text-uppercase" id="menu-title">
                <h5>Pages</h5>
            </div>
            <div id="line-square"></div>
            <div class="head-third-row text-uppercase">
                <ul>
                    {% for link in linklists.main-menu.links %}
                        <li>
                            <a href="{{ link.url }}">{{ link.title }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
  </div>

</header>

{% schema %}
  {
    "name": {
      "en": "Header",
      "th": "ส่วนหัว"
    },
    "settings": [
      {
        "type": "link_list",
        "id": "main_linklist",
        "label": {
          "en": "Menu"
        },
        "default": "main-menu"
      }, 
      {
        "type": "text",
        "id": "logo_slogan",
        "label":{
          "en": "Jasco's slogan",
          "th": "สโลแกนของแบรน"
        }
      },
      {
        "type": "text",
        "id": "button_catalogue_text",
        "label": "Button catalogue text"
      } ,
       {
        "type": "url",
        "id": "catalogue_link",
        "label": "Button catalogue text"
      } 
    ]   
  }
{% endschema %}

