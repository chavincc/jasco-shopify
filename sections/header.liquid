
<header>
    <div class="d-none d-lg-block" id="navbar-header">
      <div class="header-first-row" id="navbar-header-hide" role="navigation">
          <div class="row">
              <div class="col-lg-4 first-left d-flex justify-content-start">
                  <div class="head-logo" style="padding-top: 40px;">
                      <a href="/"><img src={{'navbar-img-jasco-logo.svg' | asset_url }} alt="{{shop.name}}"></a>
                      {% if section.settings.logo_slogan == ""%}
                        <p>Your source for food service public</p>
                      {% else %}
                          <p>{{section.settings.logo_slogan }}</p>
                      {% endif %}
                  </div>
              </div>
              <div class="col-lg-8 col-md-block first-right d-flex justify-content-end align-items-center">
                <div class="head-actions">
                    <ul class="list-inline d-flex justify-content-end align-items-center">
                     {% for link in linklists.top-menu.links %}
                            {% assign icon_name = link.title %}
                            {% assign iconTitle = icon_name  | prepend: "navbar-img-" | append: ".svg" %} 
                            <li>   
                                <img id= "icon" src= {{ iconTitle | asset_url }}/>
                               
                                {%if link.title == 'CART'%}
                                  <a href="{{routes.cart_url }}" >{{ link.title }}</a>
                                   {%if cart.item_count != 0 %}
                                      <div class="circle">
                                        <p>{{ cart.item_count }}</p>
                                      </div>
                                    {%endif}

                                {% elsif link.title == 'LOGIN' %}
                                  {% if shop.customer_accounts_enabled %}
                                    {% if customer %}
                                      <a href="{{ routes.account_url }}" class="site-header__icon site-header__account">
                                        {{ link.title }}
                                        <span class="icon__fallback-text">{{ 'layout.customer.account' | t }}</span>
                                      </a>
                                    {% else %}
                                      <a href="{{ routes.account_login_url }}" class="site-header__icon site-header__account">
                                        {{ link.title }}
                                        <span class="icon__fallback-text">{{ 'layout.customer.log_in' | t }}</span>
                                      </a>
                                    {% endif %}
                                    {{ link.title }}
                                  {% endif %}

                                {%else%}
                                  <a href="{{ link.url }}">{{ link.title }}</a>
                                {%endif%}
                            </li>
                      {% endfor %}
                    </ul>
                  </div>
                </div>
                 {% comment %} <div class="header-languages d-flex justify-content-end align-items-center" style="margin-top: 14px;">
                    <ul class="list-inline">
                        <li class="english">
                            <a class="toggle-pop" data-pop:"pop-english" href="#">
                                EN
                            </a>
                        </li>
                        <li class="line-1">
                            <p>
                                |
                            </p>
                        </li>
                        <li class="thai">
                            <a class="toggle-pop" data-pop:"pop-thai" href="#">
                                TH
                            </a>
                        </li>
                    </ul>
                </div> {% endcomment %}
              </div>
          </div>
      </div>
</header>

{% schema %}
  {
    "name": {
      "en": "Header",
      "th": "ส่วนหัว"
    },
    "settings": [
      {
        "type": "link_list",
        "id": "main_linklist",
        "label": {
          "en": "Menu"
        },
        "default": "main-menu"
      }, 
      {
        "type": "text",
        "id": "logo_slogan",
        "label":{
          "en": "Jasco's slogan",
          "th": "สโลแกนของแบรน"
        }
      }
    ] 
  }
  {% endschema %}
  