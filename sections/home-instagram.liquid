{% assign instagramLink = section.settings.instagram_username | prepend: 'https://www.instagram.com/' %}
<section id="instagram">
    <div class="row align-items-center mb-5 flex-column flex-sm-row" id="instagram-meta">
        <div class="d-flex justify-content-md-around justify-content-start col-sm-8 col-12 flex-column flex-md-row align-items-start mb-sm-0 mb-3">
            <div class="d-flex justify-content-center">
                <a id="instagram-logo" href={{ instagramLink }}>
                    <img src={{ "home-instagram-img-black-logo.svg" | asset_url }} />
                    Instagram</a>
            </div>
            <div class="d-flex justify-content-center">
                <a id="instagram-id" href={{ instagramLink }}>@{{ section.settings.instagram_username }}</a>
            </div>
        </div>
        <div class="col-12 col-sm-4 d-flex justify-content-start justify-content-sm-end align-items-start">
            <a href={{ instagramLink }}>
                <button type="button" id="instagram-follow-us-btn">
                    {{ section.settings.button_text }}
                </button>
            </a>
        </div>
    </div>
    <div class="row d-flex justify-content-center mb-0" id="instagram-recent-media">
        {% assign last = 8 %}
        {% for i in (0..last) %}
            {% assign id = i %}

            {% assign imgName = i | prepend: 'default_image_' %}
            {% assign imgURL = section.settings[imgName] | img_url: 'medium' %}

            {% assign snippetClassSuffix = "" %}
            {% if i == 8 %}
                {% assign snippetClassSuffix = "d-md-block d-lg-none d-sm-none" %}
            {% endif %}

            {% include "home-instagram-img" %}
        {% endfor %}
    </div>
</section>

{% schema %}
  {
    "name": "Home Instagram",
    "settings": [
        {
            "type": "text",
            "id": "instagram_username",
            "label": "instagram username"
        },
        {
