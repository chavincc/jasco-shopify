<section id="location-customer-service" class="pb-4">
  <div
    class="row pt-3 pb-md-5 pb-3 location-customer-service d-flex flex-column flex-md-row"
  >
    <div
      class="responsive-img-wrapper col-md-5 col-12 d-flex d-md-block justify-content-md-start justify-content-end"
    >
      <img class="responsive-img" src={{ section.settings.customer_service_image | img_url: "master" }}/>
    </div>
    <div class="col-md-1 col-0"></div>
    <div class="col-md-6 col-12">
      <div
        class="row location-customer-service-header text-capitalize pb-xl-5 pb-4 pt-3"
      >
        {{ section.settings.customer_service_header }}
      </div>
      <div class="row pb-xl-5 pb-3">
        <div class="col-xl-6 col-12 mb-3">
          <div class="row location-contact-info-wrap">
            <div class="location-contact-info-icon col-2">
              <img src={{ "get-in-touch-img-icon-tel.svg" | asset_url }}/>
            </div>
            <div class="col-9 d-flex flex-column">
              {{ section.settings.customer_service_telephone }}
            </div>
          </div>
        </div>
        <div class="col-xl-6 col-12 mb-3">
          <div class="row location-contact-info-wrap">
            <div class="location-contact-info-icon col-2">
              <img src={{ "get-in-touch-img-icon-paper-plane.svg" | asset_url }}/>
            </div>
            <div class="col-9">{{ section.settings.customer_service_email }}</div>
          </div>
        </div>
        <div class="col-xl-6 col-12 mb-3">
          <div class="row location-contact-info-wrap">
            <div class="location-contact-info-icon col-2">
              <img src={{ "get-in-touch-img-icon-fax.svg" | asset_url }}/>
            </div>
            <div class="col-9 d-flex flex-column">
              {{ section.settings.customer_service_fax }}
            </div>
          </div>
        </div>
        <div class="col-xl-6 col-12 mb-3">
          <div class="row location-contact-info-wrap">
            <div class="location-contact-info-icon col-2">
              <img src={{ "get-in-touch-img-icon-line.svg" | asset_url }}/>
            </div>
            <div class="col-9">{{ section.settings.customer_service_line }}</div>
          </div>
        </div>
      </div>
      <div class="row location-customer-service-opening-hours">
        <div
          class="col-12 location-customer-service-opening-hours-header text-capitalize"
        >
          {{ section.settings.customer_service_lower_header }}
        </div>

        <div class="col-12 location-customer-service-opening-hours-content pb-1">
          {{ section.settings.customer_service_lower_body }}
        </div>
        <div class="col-12 location-customer-service-opening-hour-closing">
          {{ section.settings.customer_service_lower_note }}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Customer Service",
    "settings": [
      {
        "type": "text",
        "id": "customer_service_header",
        "label": "header"
      },
      {
        "type": "image_picker",
        "id": "customer_service_image",
        "label": "image"
      },
      {
        "type": "richtext",
        "id": "customer_service_telephone",
        "label": "tel"
      },
      {
        "type": "richtext",
        "id": "customer_service_email",
        "label": "email"
      },
      {
        "type": "richtext",
        "id": "customer_service_fax",
        "label": "fax"
      },
      {
        "type": "richtext",
        "id": "customer_service_line",
        "label": "line"
      },
      {
        "type": "text",
        "id": "customer_service_lower_header",
        "label": "lower header"
      },
      {
        "type": "richtext",
        "id": "customer_service_lower_body",
        "label": "lower body"
      },
      {
        "type": "text",
        "id": "customer_service_lower_note",
        "label": "lower note"
      }
    ]
  }
{% endschema %}