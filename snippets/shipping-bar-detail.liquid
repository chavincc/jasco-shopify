{%- comment -%} xl and lg screen size{%- endcomment -%}
<div class="d-none d-lg-block shipping-bar-detail">
  <div class="row" id="row-shipping-bar" >
      <div class="col-xl-2 col-lg-2 col-md-2 d-flex justify-content-center">
        <div class="delivery">
          <img src= "{{ "landing-img-truck.svg" | asset_url }}" >
          <p>DELIVERY</p>
        </div>
      </div>
      <div class="d-none d-sm-block">
        <img src={{ "landing-img-line.svg" | asset_url }}/>
      </div>
      <div class="col-xl-3 col-lg-3 col-md-2 d-flex justify-content-center">
        <div class="returns">
          <img src="{{ "landing-img-box.svg" | asset_url }}"/>
          <p >RETURNS-CLAIMS</p>
        </div>
      </div>
      <div class="d-none d-sm-block">
        <img src={{ "landing-img-line.svg" | asset_url }}/>
      </div>
      <div class="col-xl-2 col-lg-2 col-md-1 d-flex justify-content-center">
        <div class="faq">
          <img src="{{ "landing-img-faq.svg" | asset_url }}"/>
          <p>FAQ</p>
        </div>
      </div>
      <div class="d-none d-sm-block">
        <img src={{ "landing-img-line.svg" | asset_url }}/>
      </div>
      <div class="col-xl-3 col-lg-4 col-md-3 d-flex justify-content-center">
        <div class="best-online">
          <img src="{{ "landing-img-online-shopping.svg" | asset_url }}"/>
          <p >BEST ONLINE SUPPORT</p>
        </div>
      </div>
  </div>
</div>

{%- comment -%} md screen size{%- endcomment -%}
<div class="d-none d-md-block d-lg-none shipping-bar-detail">
  <div class="row d-flex justify-content-center" id="row-md-shipping">
    <div class="col-md-2"></div>
    <div class="col-lg-3 col-md-3">
      <div class="delivery">
        <img src="{{ "landing-img-truck.svg" | asset_url }}"/>
        <p>DELIVERY</p>
      </div>
    </div>
    <div class="col-lg-1 col-md-1 d-none d-md-block">
      <img src={{ "landing-img-line.svg" | asset_url }}/>
    </div>
    <div class="col-lg-6 col-md-6 col-sm-3">
      <div class="returns">
        <img src="{{ "landing-img-box.svg" | asset_url }}"/>
        <p style="padding-left: 3px; padding-bottom: 14px;">RETURNS-CLAIMS</p>
      </div>
    </div>
  </div>
  <div class="row d-flex justify-content-center" id="row-md-shipping">
    <div class="col-md-2"></div>
    <div class="col-lg-3 col-md-3 col-sm-3">
      <div class="faq">
        <img src="{{ "landing-img-faq.svg" | asset_url }}"/>
        <p style="padding-left: 10px; padding-bottom: 8px;">FAQ</p>
      </div>
    </div>
    <div class="col-lg-1 col-md-1 d-none d-sm-block">
      <img src={{ "landing-img-line.svg" | asset_url }}/>
    </div>
    <div class="col-lg-6 col-md-6 col-sm-3">
      <div class="best-online">
        <img src="{{ "landing-img-online-shopping.svg" | asset_url }}">
        <p>BEST ONLINE SUPPORT</p>
      </div>
    </div>
  </div>
</div>

<div class="d-md-none xs-shipping-bar">
    <div class="row d-flex justify-content-center" id="row-xs-shipping">
      <div class="col-xs-6">
        <div class="xs-delivery">
          <img src="{{ "landing-img-truck.svg" | asset_url }}"/>
          <p style="padding-top: 6px;">DELIVERY</p>
        </div>
      </div>
      <div class="col-xs-6">
        <div class="xs-returns">
         <img src="{{ "landing-img-box.svg" | asset_url }}" />
          <p>RETURNS-CLAIMS</p>
        </div>
      </div>
    </div>
    <div class="row d-flex justify-content-center" id= "second-rows-shipping">
      <div class="col-xs-6">
        <div class="xs-faq">
          <img src="{{ "landing-img-faq.svg" | asset_url }}" />
          <p style="margin-left: -2px;">FAQ</p>
        </div>
      </div>
      <div class="col-xs-6">
        <div class="xs-best-online" >
        <img src="{{ "landing-img-online-shopping.svg" | asset_url }}"/>
          <p style="padding-top: 3px;">BEST ONLINE SUPPORT</p>
        </div>
      </div>
    </div>
  </div>