<div class="recent-media-wrapper col-12 col-sm-6 col-md-4 col-lg-3 mb-1 {{ snippetClassSuffix }}">
    <img
        class="recent-media-child"
        id="instagram-media-{{ id }}"
        src={{ imgURL }}
    />
    <a href={{ instagramLink }}>
        <div class="dark-overlay">
            <img src={{ "home-instagram-img-overlay-logo.svg" | asset_url }}>
        </div>
    </a>
</div>