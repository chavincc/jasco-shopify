{% comment %}
    Renders a pagination bar

    Accepts:
    - paginate: {Object} Paginate Liquid object (required)

    Usage:
    {% include 'pagination', paginate: paginate %}
{% endcomment %}

<div class="row d-flex align-items-center justify-content-center">
  <div class="pagination mb-sm-0 mb-5">
    <a class="pagination-arrow-wrapper" id="pagination-arrow-wrapper-left" href="{% if paginate.previous.is_link %}{{ paginate.previous.url }}{% else %}#{% endif %}">
      <img src={{ "pagination-arrow-right.svg" | asset_url }} id="pagination-arrow-left">
    </a>
    {% for i in (1..paginate.pages) %}
      <div class="pagination-number{% if i == paginate.current_page %} current{% endif %}" id="pagination-number-{{i}}">{{i}}</div>
    {% endfor %}
    <a class="pagination-arrow-wrapper" id="pagination-arrow-wrapper-right" href="{% if paginate.next.is_link %}{{ paginate.next.url }}{% else %}#{% endif %}">
      <img src={{ "pagination-arrow-right.svg" | asset_url }} id="pagination-arrow-right">
    </a>
  </div>
</div>

{{ 'pagination-jump.js' | asset_url | script_tag }}
