{% assign first_variant = product.first_available_variant %}

{% if product.variants.size == 1 %}
    {% assign img_src = product | img_url: 'master' %}
{% else %}
    {% assign img_src = first_variant | img_url: 'master' %}
{% endif %}

{% assign product_name = product.title %}
{% assign image_id = "subpage-product-img-" | append: product_name %}
{% assign arrow_right_container_id = "arrow-right-container-" | append: product_name %}
{% assign arrow_left_container_id = "arrow-left-container-" | append: product_name %}
{% assign product_link_id = "product-add-to-cart-" | append: product_name %}
{% assign cart_data_id = "product-add-to-cart-id-" | append: product_name %}

{% comment %}
    GET ITERABLE COLOR OBJECT
    OUTPUT INTERFACE:
        STRING[] color_iterate,
            ** note that color contains white space around it... always strip before use
        INTEGER color_count,
        BOOLEAN have_color,
{% endcomment %}
{% if product.options contains 'Color' %}
    {% assign have_color = true %}
    <script>
        PRODUCT_COLOR_MAP["{{ product_name }}"] = {variant: {}}
    </script>
{% else %}
    {% assign have_color = false %}
{% endif %}
{% for option in product.options %}
    {% if option == 'Color' %}
        {% assign index = forloop.index0 %}
        {% assign colorlist = '' %}
        {% assign color = '' %}
        {% assign color_count = 0 %}
        {% for variant in product.variants %}
            {% capture color %}
                {{ variant.options[index] }}
            {% endcapture %}
            {% unless colorlist contains color %}
                {% capture stripped_color %}{{ color | strip }}{% endcapture %}
                <script>
                    PRODUCT_COLOR_MAP["{{ product_name }}"]["variant"]["{{ stripped_color }}"] = {
                        src: "{{ variant | img_url: 'master' }}",
                        link: "{{ variant.url }}",
                        id: "{{ variant.id }}",
                        filterId: "product-color-picker-{{ product_name }}-{{ stripped_color }}"
                    };
                </script>
                {% capture tempList %}
                    {{ colorlist | append: color | append: "," }}
                {% endcapture %}
                {% assign colorlist = tempList %}
                {% assign color_count = color_count | plus: 1 %}
            {% endunless %}
        {% endfor %}
    {% endif %}
{% endfor %}
{% if have_color %}
    {% assign color_iterate = "" %}
    {% assign raw_colorlist = colorlist | split: ',' %}
    {% for raw_color in raw_colorlist %}
        {% if forloop.index != forloop.length %}
            {% capture processed_color %}{{ raw_color | strip }}{% endcapture %}
            {% assign last_relevant_index = forloop.length | minus: 1 %}
            {% if forloop.index == last_relevant_index %}
                {% assign delimiter = "" %}
            {% else %}
                {% assign delimiter = "," %}
            {% endif %}
            {% capture temp_color_iterate %}
                {{ color_iterate | append: processed_color | append: delimiter }}
            {% endcapture %}
            {% assign color_iterate = temp_color_iterate %}
        {% endif %}
    {% endfor %}
    {% assign color_iterate = color_iterate | split: ',' %}
{% else %}
    {% assign color_iterate = nil %}
{% endif %}

<div class="product p-0 m-0 mb-5 d-flex flex-column align-items-md-start align-items-center" id="product-{{product.title}}">
    <div class="product-inner-wrapper">
        <div class="less-shadow product-img mb-3">
            <img id="{{ image_id }}" src="{{ img_src }}"/>
            {% if have_color %}
                <div class="arrow-left-container" id="{{ arrow_left_container_id }}">
                    <img src={{ "collection-img-product-arrow-right.svg" | asset_url }} id="arrow-left-{{product.title}}">
                </div>
                <div class="arrow-right-container" id="{{ arrow_right_container_id }}">
                    <img src={{ "collection-img-product-arrow-right.svg" | asset_url }} id="arrow-right-{{product.title}}">
                </div>
            {% endif %}
            
            <div class="product-add-to-cart-popup">
                <a id="{{ product_link_id }}" href="{{ product.url }}">
                    <div class="product-add-to-cart-popup-text text-uppercase">
                        quick look
                    </div>
                </a>
                <form class="product-add-to-cart-popup-icon" method="post" action="/cart/add">
                    <input type="hidden" name="id" id="{{ cart_data_id }}" value="{{ first_variant.id }}" />
                    <input type="hidden" min="1" type="number" name="quantity" value="1"/>
                    <button type="submit"><img src={{ "home-best-sellers-img-icon-shopping-bag.svg" | asset_url }}/></button>
                </form>
            </div>
        </div>
        <div class="product-text-wrapper mx-1">
            <div class="row px-0 pb-1 product-name-wrapper">
                <div class="col-12 px-0 product-name text-capitalize">
                    {{ product.title }}
                </div>
            </div>
            <div class="row px-0 product-meta mb-4 d-flex align-items-center">
                <div class="product-id px-0 col-4">
                    {{ first_variant.sku }}
                </div>
                <div class="product-price px-0 col-5 text-right">
                    {{ product.price | money_without_trailing_zeros }}
                </div>
                <div class="wishlist-container pl-0 col-3 d-flex justify-content-end">
                    <img src={{ "product-img-icon-heart.svg" | asset_url}}/>
                </div>
            </div>
        </div>
        <div class="product-color-picker-wrapper d-flex" id="product-color-picker-wrapper-{{ product_name }}">
            {% for raw_color in color_iterate %}
                {% assign color = raw_color | strip %}
                {% if forloop.index0 == 0 %}<script>PRODUCT_COLOR_MAP["{{ product_name }}"].currentColor = "{{ color }}"</script>{% endif %}
                <div class="product-color-picker{% if forloop.index0 == 0 %} current{% endif %}" id="product-color-picker-{{ product_name }}-{{ color }}">
                    <div class="product-color-picker-inner-{{ color }}" id="product-color-picker-inner-{{ product_name }}-{{ color }}"></div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<script>
    var switchCollectionProductCurrentColor = (productName = '', newCurrentColor = '', {
        cart = '',
        link = '',
        image = ''
    }) => {
        const productObject = PRODUCT_COLOR_MAP[productName]
        productObject.currentColor = newCurrentColor
        Object.keys(productObject["variant"]).forEach(color => {
            if (color === newCurrentColor) {
                $(`#${productObject["variant"][color].filterId}`).addClass("current");
            } else {
                $(`#${productObject["variant"][color].filterId}`).removeClass("current");
            }
        })
        $(`#${cart}`).val(productObject["variant"][newCurrentColor].id);
        $(`#${link}`).attr("href", productObject["variant"][newCurrentColor].link);
        $(`#${image}`).attr("src", productObject["variant"][newCurrentColor].src);
    }
</script>

{% comment %}
    var PRODUCT_COLOR_MAP = {} should passed down from sections/collection-template.liquid
{% endcomment %}
{% for raw_color in color_iterate %}
    {% assign color = raw_color | strip %}
    <script>
        $("#product-color-picker-{{ product_name }}-{{ color }}").click(() => {
            switchCollectionProductCurrentColor("{{ product_name }}", "{{ color }}", {
                cart: '{{ cart_data_id }}',
                link: '{{ product_link_id }}',
                image: '{{ image_id }}'
            })
        })
    </script>    
{% endfor %}

<script>
    var ITERATE_DIRECTION = {
        FORWARD: 'FORWARD',
        BACKWARD: 'BACKWARD'
    }
    var iterateColorPicker = (productName = '', direction = '', {
        cart = '',
        link = '',
        image = ''
    }) => {
        const allColor = Object.keys(PRODUCT_COLOR_MAP[productName]["variant"])
        const currentColor = PRODUCT_COLOR_MAP[productName].currentColor

        const currentColorIndex = allColor.findIndex(
            (item) => item === currentColor
        );
        const colorIndex = (direction === ITERATE_DIRECTION.FORWARD) ? 1 : allColor.length - 1;
        const newColor = allColor[(currentColorIndex + colorIndex) % allColor.length];

        PRODUCT_COLOR_MAP[productName].currentColor = newColor;
        switchCollectionProductCurrentColor(productName, newColor, { cart, link, image })
    }

    $("#{{ arrow_right_container_id }}").click(() => {
        iterateColorPicker("{{ product_name }}", ITERATE_DIRECTION.FORWARD, {
            cart: "{{ cart_data_id }}",
            link: "{{ product_link_id }}",
            image: "{{ image_id }}"
        })
    })
    $("#{{ arrow_left_container_id }}").click(() => {
        iterateColorPicker("{{ product_name }}", ITERATE_DIRECTION.BACKWARD, {
            cart: "{{ cart_data_id }}",
            link: "{{ product_link_id }}",
            image: "{{ image_id }}"
        })
    })
</script>